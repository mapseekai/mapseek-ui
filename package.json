{
  "name": "@mapseek/ui-registry",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p packages/docs/tsconfig.json --noEmit",
    "lint": "biome check .",
    "design:lint": "designmd lint DESIGN.md",
    "format": "biome format --write .",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "registry:build": "tsx scripts/build-registry.ts",
    "registry:serve": "tsx scripts/registry-server.ts",
    "verify:items": "tsx scripts/verify-items.ts",
    "verify:aggregate": "tsx scripts/verify-aggregate.ts",
    "smoke:dlx-command": "tsx scripts/smoke-dlx-command.ts",
    "docs:theme": "tsx scripts/generate-docs-theme.ts",
    "docs:sources": "tsx scripts/generate-showcase-sources.ts",
    "docs:dev": "pnpm run registry:build && pnpm run docs:theme && pnpm run docs:sources && tsx scripts/start-dev.ts",
    "showcase:dev": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "docs:build": "pnpm run registry:build && pnpm run docs:theme && pnpm run docs:sources && pnpm --filter @mapseek/docs build && pnpm run showcase:build",
    "docs:check-i18n": "tsx scripts/check-docs-i18n.ts",
    "docs:check-examples": "tsx scripts/check-docs-examples.ts",
    "docs:visual": "tsx scripts/run-docs-visual.ts",
    "docs:verify": "pnpm run lint && pnpm run typecheck && pnpm run registry:validate && pnpm run docs:check-i18n && pnpm run docs:check-examples && pnpm run docs:build && pnpm test && pnpm run docs:visual && pnpm run verify:items button layout layer-panel"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@biomejs/biome": "^2.5.6",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@google/design.md": "0.4.0",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "^1.62.1",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/bun": "^1.3.14",
    "@types/color": "^4.2.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "color": "^5.0.3",
    "json-stringify-pretty-compact": "^4.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.10.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.1"
  }
}
