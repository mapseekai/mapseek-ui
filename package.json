{
  "name": "@mapseek/ui-registry",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p packages/docs/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "registry:validate": "bun scripts/validate-registry.ts",
    "registry:build": "bun scripts/build-registry.ts",
    "registry:serve": "bun scripts/registry-server.ts",
    "verify:items": "bun scripts/verify-items.ts",
    "verify:aggregate": "bun scripts/verify-aggregate.ts",
    "smoke:bun-command": "bun scripts/smoke-bun-command.ts",
    "docs:theme": "bun scripts/generate-docs-theme.ts",
    "docs:dev": "bun run registry:build && bun run docs:theme && bun run --cwd packages/docs start",
    "docs:dev:en": "bun run registry:build && bun run docs:theme && bun run --cwd packages/docs start -- --locale en",
    "docs:build": "bun run registry:build && bun run docs:theme && bun run --cwd packages/docs build",
    "docs:serve": "bun run --cwd packages/docs serve",
    "docs:check-i18n": "bun scripts/check-docs-i18n.ts",
    "docs:check-examples": "bun scripts/check-docs-examples.ts",
    "docs:visual": "bun scripts/run-docs-visual.ts",
    "docs:verify": "bun run lint && bun run typecheck && bun run registry:validate && bun run docs:check-i18n && bun run docs:check-examples && bun run docs:build && bun test && bun run docs:visual && bun run verify:items button layout layer-panel"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@biomejs/biome": "^2.5.0",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.11",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@tabler/icons-react": "^3.41.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/bun": "^1.3.14",
    "@types/color": "^4.2.0",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^6.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "color": "^5.0.3",
    "json-stringify-pretty-compact": "^4.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.4"
  }
}
