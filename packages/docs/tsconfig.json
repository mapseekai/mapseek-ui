{
  "compilerOptions": {
    "baseUrl": "../..",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/registry/*": ["registry/*"],
      "@registry/*": ["registry/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "src", "docs"]
}
