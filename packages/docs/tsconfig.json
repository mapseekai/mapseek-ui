{
  "compilerOptions": {
    "baseUrl": "../..",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/components/blocks/*": ["registry/blocks/*"],
      "@/components/ui/*": ["registry/ui/*"],
      "@/lib/mapseek-labels": ["registry/lib/labels.ts"],
      "@/lib/svg-data-uri": ["registry/lib/svg-data-uri.ts"],
      "@/lib/utils": ["registry/lib/utils.ts"],
      "@/registry/*": ["registry/*"],
      "@registry/*": ["registry/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "react", "@docusaurus/module-type-aliases"]
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "src", "docs"]
}
